generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type UserCart {
  id                   String   @map("_id")
  addedDate            DateTime @db.Date
  deliveryAvailability Boolean
  editedDate           DateTime @db.Date
  img                  String
  link                 String
  materialAndSize      String
  name                 String
  pickupAvailability   Boolean
  price                Float
  productId            String
  qty                  Int
}

model cartProduct {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  addedDate            DateTime @db.Date
  deliveryAvailability Boolean
  editedDate           DateTime @db.Date
  img                  String
  link                 String
  materialAndSize      String
  name                 String
  pickupAvailability   Boolean
  price                Float
  productId            String
  qty                  BigInt
}

model promoCode {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  active      Boolean
  createdAt   DateTime @db.Date
  description String
  discount    Float
  endDate     DateTime @db.Date
  promoCode   String
}

model user {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  cart      UserCart[]
  createdAt DateTime   @db.Date
  email     String
  givenName String
  lastName  String
  picture   String
  sub       String     @unique(map: "sub_1")
}
